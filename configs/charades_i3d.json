{
  "architecture": "PointDiff",
  "seed": 25285,
  "model": {
    "video_dim": 1024,
    "text_dim": 768,
    "hidden_dim": 256,
    "heads": 8,
    "ffn_dim": 2048,
    "dropout": 0.1,
    "num_spans": 8,
    "timesteps": 1000,
    "sampling_steps": 2,
    "ddim_eta": 1.0,
    "time_embed_scale": 0.1,
    "gpc_threshold": 0.7,
    "gaussian_sigma": 0.3,
    "dga_window": 5,
    "dga_threshold": 0.9,
    "lambda1": 0.1,
    "lambda2": 0.9,
    "weight_threshold": 0.6,
    "loss_mse_weight": 0.5,
    "loss_l1_weight": 0.5,
    "loss_iou_weight": 0.1,
    "loss_ce_weight": 0.2,
    "gpc_device": "cpu",
    "sampling_method": "momentdiff_ddim",
    "gaussian_coordinates": "frame_index",
    "gpc_boundary_mode": "point_component",
    "loss_span_bounds": "unclipped",
    "decoder_layers": 2,
    "matching_method": "momentdiff_hungarian",
    "noise_loss_mode": "auxiliary",
    "condition_prior": "none",
    "record_condition_diagnostics": true,
    "match_cost_span": 10.0,
    "match_cost_giou": 1.0,
    "match_cost_class": 4.0,
    "background_weight": 0.1,
    "auxiliary_loss": true,
    "auxiliary_loss_weight": 1.0
  },
  "data": {
    "dataset_name": "charades",
    "train_annotations": "dataset/Charades_STA/annotations/train_points.json",
    "eval_annotations": "dataset/Charades_STA/annotations/test.json",
    "video_features": "dataset/Charades_STA/video_i3d",
    "text_features": "dataset/Charades_STA/text_distilbert",
    "num_clips": 32,
    "max_query_len": 32,
    "cache_video": true,
    "video_cache_capacity": null,
    "cache_text": true,
    "text_cache_capacity": null,
    "gpc_video_cache_capacity": 128,
    "validation_annotations": "dataset/Charades_STA/annotations/validation.json",
    "test_annotations": "dataset/Charades_STA/annotations/test.json",
    "split_manifest": "dataset/Charades_STA/annotations/split.json"
  },
  "training": {
    "epochs": 100,
    "batch_size": 48,
    "lr": 0.0001,
    "betas": [
      0.9,
      0.99
    ],
    "weight_decay": 1e-05,
    "grad_clip": 1.0,
    "checkpoint_every": 10,
    "scheduler": {
      "type": "multistep",
      "milestones": [
        40,
        80
      ],
      "gamma": 0.1
    }
  },
  "output": "outputs/charades_i3d",
  "validation": {
    "enabled": true,
    "every": 1,
    "batch_size": 48,
    "seed": 25285,
    "selection_metric": "mean_recall",
    "candidate_diagnostics": true
  },
  "evaluation": {
    "candidate_diagnostics": true,
    "postprocessing": {
      "method": "soft_nms",
      "sigma": 0.5
    }
  }
}
